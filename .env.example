# env (default): local Docker on http://localhost:3000 — no ngrok tunnel
# prod: enable ngrok public URL in the all-in-one container
ENVIRONMENT=prod

TUNNEL_PROVIDER=ngrok
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=untrained-pleading-unmarked.ngrok-free.dev
ZROK_ENV_TOKEN=your-zrok-env-token
ZROK_API_ENDPOINT=https://api-v2.zrok.io
ZROK_RESERVED_NAME=tmsautomationlive

# LLM routing — try providers in order; fallback immediately on any model error
AI_LLM_PROVIDERS=gemini,cohere,nvidia,groq
AI_LLM_PRIMARY=gemini
AI_LLM_FALLBACK=cohere
AI_LLM_TERTIARY=groq

# Google Gemini API (OpenAI-compatible) — fast default model
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95
GEMINI_MAX_TOKENS=4096

# Cohere API — second fallback (command-r7b-12-2024)
COHERE_API_KEY=your-cohere-api-key
COHERE_MODEL=command-r7b-12-2024
COHERE_TEMPERATURE=0.1
COHERE_TOP_P=1
COHERE_MAX_TOKENS=4096

# Groq API (gsk_* keys) — fallback with compact prompt + fast 8B model
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2
GROQ_TOP_P=1
GROQ_MAX_TOKENS=1024
# Keep Groq system prompt under on-demand TPM (12000); full keys still included
GROQ_MAX_SYSTEM_PROMPT_CHARS=4500
AI_SYSTEM_PROMPT_MAX_CHARS=12000

# NVIDIA integrate API — generate nvapi-* keys at https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_EFFORT=high
NVIDIA_AI_MAX_RETRIES=5
