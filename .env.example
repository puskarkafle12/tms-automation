# test = local Docker (no ngrok) | prod = production with ngrok
ENVIRONMENT=test

# Database (Docker all-in-one)
DB_USER=pk
DB_PASSWORD=pk
DB_HOST=127.0.0.1
DB_NAME=stock
SQL_ECHO=false

# Frontend login seed (first-run admin user)
FRONTEND_SEED_USER=admin
FRONTEND_SEED_PASSWORD=admin

# Public tunnel (used when ENVIRONMENT=prod)
TUNNEL_PROVIDER=ngrok
NGROK_AUTHTOKEN=REDACTED_CREDENTIAL
NGROK_DOMAIN=untrained-pleading-unmarked.ngrok-free.dev

# NVIDIA integrate API — Stock Screener Ask AI (DeepSeek v4 Flash)
NVIDIA_API_KEY=REDACTED_CREDENTIAL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_EFFORT=high
NVIDIA_AI_MAX_RETRIES=5
